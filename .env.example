# Copy to .env and fill in. .env is git-ignored.
BASE_URL=https://dmoneyportal.roadtocareer.net
API_URL=https://dmoney.roadtocareer.net

ADMIN_EMAIL=admin@dmoney.com
ADMIN_PASSWORD=1234
SYSTEM_EMAIL=system@dmoney.com
SYSTEM_PASSWORD=1234

# Your own Gmail. Each run registers <name>+agent<timestamp>@gmail.com,
# so the OTP and reset-link emails arrive in this inbox.
AGENT_GMAIL=yourname@gmail.com
AGENT_PASSWORD=1234
AGENT_NEW_PASSWORD=5678

# Phone number of an existing ACTIVE customer (receives the agent's 500 Tk)
CUSTOMER_PHONE=01711314167

# Optional: slow every action down (ms) so the headed video is easier to follow
SLOW_MO=0
